# AgriShift AI Application Configuration
APP_NAME=AgriShift AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
CORS_ORIGINS=*

# NASA Earthdata Authentication (required for NASA GPM / SMAP DAAC access)
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# Default Target Region (Hooghly, West Bengal, India)
DEFAULT_LATITUDE=22.90
DEFAULT_LONGITUDE=88.40
